                ],
                "summary": "Get the authenticated user",
                "operationId": "198e2c87b3af232810f8f306eef86495",
                "responses": {
                    "200": {
                        "description": "The current user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
