                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Email address not verified"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/auth/logout-all": {
            "post": {
                "tags": [
                    "User"
                ],
                "summary": "Logout the current user from all devices (revokes all tokens)",
                "operationId": "cb4dc83917db0d5fff6f1f5a2562c05b",
                "responses": {
                    "200": {
                        "description": "Logged out everywhere",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Email address not verified"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/unsplash/image/general": {
            "get": {
                "tags": [
                    "Unsplash Images"
                ],
                "summary": "Fetch a random background image from Unsplash collections",
                "description": "Public, throttled to 60 requests/minute. Falls back to the configured default collections when none are given.",
                "operationId": "14041fc0ef8e8b206375b1a64f88ea50",
                "parameters": [
                    {
                        "name": "collection_ids",
                        "in": "query",
                        "description": "Unsplash collection IDs (comma-separated or repeated collection_ids[]).",
                        "explode": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "name": "collection_id",
                        "in": "query",
                        "description": "A single Unsplash collection ID.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "collections",
                        "in": "query",
                        "description": "Alias for collection_ids.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashVariant"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashStrategy"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashResponse"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashWidth"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashHeight"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashQuality"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashFit"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashCacheTtl"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashTimezone"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Image URL and photo data (response=json)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnsplashImageResponse"
                                }
                            }
                        }
                    },
                    "302": {
                        "description": "Redirect to the image (response=redirect, default)"
                    },
                    "422": {
                        "description": "No collection IDs provided or configured / invalid input",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    },
                    "502": {
                        "description": "Unsplash request failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/unsplash/image/seasonal": {
            "get": {
                "tags": [
                    "Unsplash Images"
                ],
                "summary": "Fetch a seasonal background image from Unsplash",
                "description": "Public, throttled to 60 requests/minute. Uses the collection configured for the season; the season is auto-detected when omitted.",
                "operationId": "e4eef923b6d09339811c4eafd61a46f8",
                "parameters": [
                    {
                        "name": "season",
                        "in": "query",
                        "description": "Season to use ('fall' is accepted as autumn). Defaults to the current season.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "spring",
                                "summer",
                                "autumn",
                                "winter"
                            ]
                        }
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashVariant"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashStrategy"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashResponse"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashWidth"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashHeight"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashQuality"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashFit"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashCacheTtl"
                    },
                    {
                        "$ref": "#/components/parameters/UnsplashTimezone"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Image URL, photo data and season (response=json)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnsplashImageResponse"
                                }
                            }
                        }
                    },
                    "302": {
                        "description": "Redirect to the image (response=redirect, default)"
                    },
                    "422": {
                        "description": "No collection configured for the season",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    },
                    "502": {
                        "description": "Unsplash request failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/contact-submissions": {
            "get": {
                "tags": [
                    "Contact Submissions"
                ],
                "summary": "List contact submissions (admin)",
                "description": "Display a listing of the resource.",
                "operationId": "4cf5d619827fc43c000ac2df41a5cb4e",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Items per page (clamped to 1-50).",
                        "schema": {
                            "type": "integer",
                            "default": 10,
                            "maximum": 50,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number.",
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated submissions, newest first",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "current_page": {
                                            "type": "integer"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ContactSubmission"
                                            }
                                        },
                                        "per_page": {
                                            "type": "integer"
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "last_page": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Not an admin or email not verified"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Contact Submissions"
                ],
                "summary": "Submit the contact form",
                "description": "Public endpoint. Stores the submission and queues a notification email.",
                "operationId": "b8d09ce2ab54ffffad1735b12afb618a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "subject",
                                    "message"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "phone": {
                                        "type": "string",
                                        "nullable": true,
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "maxLength": 255
                                    },
                                    "subject": {
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "message": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Submission stored",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                },
                                "example": "OK"
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/contact-submissions/{contactSubmission}": {
