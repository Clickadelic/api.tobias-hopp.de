APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=temp_folder
DB_USERNAME=root
DB_PASSWORD=

REZEPTBUCH_DB_CONNECTION=mysql
REZEPTBUCH_DB_HOST=XXX
REZEPTBUCH_DB_PORT=3306
REZEPTBUCH_DB_DATABASE=database_name
REZEPTBUCH_DB_USERNAME=database_user
REZEPTBUCH_DB_PASSWORD=database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Required for Sanctum SPA cookie auth from the dashboard (React/Vite) frontend.
# Local dev (dashboard running via Docker/Vite on localhost:5173):
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
# Production (cookies shared across subdomains so dashboard.tobias-hopp.de can
# authenticate against api.tobias-hopp.de) - set these on the server instead:
# SESSION_DOMAIN=.tobias-hopp.de
# SANCTUM_STATEFUL_DOMAINS=dashboard.tobias-hopp.de

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET=
UNSPLASH_CALLBACK_URL=
UNSPLASH_ACCESS_TOKEN=
UNSPLASH_REFRESH_TOKEN=
UNSPLASH_ACCESS_TOKEN_EXPIRES_AT=
UNSPLASH_UTM_SOURCE="${APP_NAME}"
UNSPLASH_COLLECTION_IDS=
# Seasonal mapping (optional, used by /api/background/seasonal)
UNSPLASH_COLLECTION_SPRING_ID=
UNSPLASH_COLLECTION_SUMMER_ID=
UNSPLASH_COLLECTION_AUTUMN_ID=
UNSPLASH_COLLECTION_WINTER_ID=

VITE_APP_NAME="${APP_NAME}"
